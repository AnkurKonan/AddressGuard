# Optional for local development. Set a strong random value in production.
# When configured, every /v1/* endpoint requires the X-API-Key header.
ADDRESSGUARD_API_KEY=replace-with-a-long-random-secret

# Set only when listing on RapidAPI: copy the Proxy Secret from the marketplace
# gateway settings. Requests carrying it in X-RapidAPI-Proxy-Secret are accepted.
MARKETPLACE_PROXY_SECRET=

# On Cloudflare Workers set these as secrets instead of .env:
#   npx wrangler secret put ADDRESSGUARD_API_KEY
#   npx wrangler secret put MARKETPLACE_PROXY_SECRET
